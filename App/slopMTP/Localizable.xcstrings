    "Drop games, updates or DLC anywhere in this window to install them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "أفلت الألعاب أو التحديثات أو DLC في أي مكان في هذه النافذة لتثبيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Lege Spiele, Updates oder DLCs irgendwo in diesem Fenster ab, um sie zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Suelta juegos, actualizaciones o DLC en cualquier lugar de esta ventana para instalarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Déposez des jeux, des mises à jour ou des DLC n’importe où dans cette fenêtre pour les installer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "इंस्टॉल करने के लिए गेम्स, अपडेट या DLC को इस विंडो में कहीं भी ड्रॉप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Trascina giochi, aggiornamenti o DLC in un punto qualsiasi di questa finestra per installarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ゲーム、更新データ、追加コンテンツをこのウインドウ内の任意の場所にドロップしてインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "설치하려면 게임, 업데이트 또는 추가 콘텐츠를 이 윈도우의 아무 곳에나 놓으십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zet games, updates of DLC ergens in dit venster neer om ze te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Upuść gry, aktualizacje lub DLC w dowolnym miejscu tego okna, aby je zainstalować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Solte jogos, atualizações ou DLC em qualquer lugar desta janela para instalá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Перетащите игры, обновления или DLC в любое место этого окна, чтобы установить их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kurmak için oyunları, güncellemeleri veya DLC’leri bu pencerede herhangi bir yere bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Перетягніть ігри, оновлення або DLC у будь-яке місце цього вікна, щоб встановити їх."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "将游戏、更新或追加内容拖放到此窗口中的任意位置即可安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "將遊戲、更新或追加內容拖放到此視窗中的任意位置即可安裝。"
          }
        }
      }
    },
