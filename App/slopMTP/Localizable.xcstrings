    "Base games install first, then updates, then DLC. Items already on the console are unchecked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "تُثبَّت الألعاب الأساسية أولًا، ثم التحديثات، ثم DLC. العناصر الموجودة على الجهاز بالفعل غير محددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zuerst werden Hauptspiele installiert, dann Updates, dann DLCs. Objekte, die bereits auf der Konsole sind, sind nicht ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Primero se instalan los juegos base, luego las actualizaciones y después los DLC. Los ítems que ya están en la consola aparecen desmarcados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les jeux de base sont installés en premier, puis les mises à jour, puis les DLC. Les éléments déjà présents sur la console sont décochés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पहले बेस गेम्स इंस्टॉल होते हैं, फिर अपडेट, फिर DLC। जो आइटम कंसोल पर पहले से हैं, वे अचयनित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Vengono installati prima i giochi base, poi gli aggiornamenti e infine i DLC. Gli elementi già presenti sulla console sono deselezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ゲーム本編、更新データ、追加コンテンツの順にインストールされます。すでに本体にある項目はチェックされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "기본 게임을 먼저 설치한 다음 업데이트, 추가 콘텐츠 순으로 설치합니다. 이미 본체에 있는 항목은 선택 해제되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Eerst worden basisgames geïnstalleerd, dan updates en daarna DLC. Onderdelen die al op de console staan, zijn niet aangevinkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Najpierw instalowane są gry podstawowe, potem aktualizacje, a na końcu DLC. Elementy, które są już na konsoli, są odznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os jogos base são instalados primeiro, depois as atualizações e por fim os DLC. Itens que já estão no console ficam desmarcados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Сначала устанавливаются основные игры, затем обновления, затем DLC. Флажки объектов, которые уже есть на консоли, сняты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Önce ana oyunlar, ardından güncellemeler, en son da DLC’ler kurulur. Konsolda zaten bulunan öğelerin işareti kaldırılmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Спершу встановлюються основні ігри, потім оновлення, потім DLC. Позначки з об’єктів, які вже є на консолі, знято."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "先安装游戏本体，再安装更新，最后安装追加内容。已在主机上的项目不会被勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "先安裝遊戲本體，再安裝更新，最後安裝追加內容。已在主機上的項目不會勾選。"
          }
        }
      }
    },
