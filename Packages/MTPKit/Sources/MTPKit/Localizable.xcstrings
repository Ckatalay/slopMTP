      "comment": "Error",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "تعذّر العثور على جهاز MTP. هل لا يزال متصلًا؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Das MTP-Gerät wurde nicht gefunden. Ist es noch verbunden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "No se ha encontrado el dispositivo MTP. ¿Sigue conectado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "L’appareil MTP est introuvable. Est-il toujours connecté ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "MTP डिवाइस नहीं मिला। क्या यह अभी भी कनेक्ट है?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Impossibile trovare il dispositivo MTP. È ancora collegato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "MTP デバイスが見つかりませんでした。まだ接続されていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "MTP 기기를 찾을 수 없습니다. 아직 연결되어 있습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kan het MTP-apparaat niet vinden. Is het nog verbonden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nie można znaleźć urządzenia MTP. Czy nadal jest podłączone?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Não foi possível encontrar o dispositivo MTP. Ele ainda está conectado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Не удалось найти MTP-устройство. Оно все еще подключено?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "MTP aygıtı bulunamadı. Hâlâ bağlı mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Не вдалося знайти MTP-пристрій. Він досі під’єднаний?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "找不到 MTP 设备。它是否仍处于连接状态？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "找不到 MTP 裝置。它是否仍保持連接？"
          }
        }
      }
    },
    "The device did not respond in time.": {
